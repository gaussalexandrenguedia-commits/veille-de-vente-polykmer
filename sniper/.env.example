# ── Telegram (alertes push < 1 s) ──────────────────────────────
# Créer le bot via @BotFather, puis récupérer le chat_id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=123456789
DASHBOARD_URL=http://localhost:8501

# ── Fan-out multi-canaux (optionnel, format Apprise, séparés par ;) ─
# Ex : discord://webhook_id/webhook_token;slack://TokenA/TokenB/TokenC
APPRISE_URLS=

# ── API veille (stockage des signaux comme relevés/offres) ─────────
API_URL=http://localhost:8000
API_KEY_INGEST=changez-moi-cle-ingest

# Agent IA — gate sémantique `backend: gemini` (optionnel)
GEMINI_API_KEYS=cle1,cle2,cle3
GEMINI_MODEL=gemini-2.5-flash
